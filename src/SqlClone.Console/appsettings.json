{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Clone": {
    "EnvironmentName": "Development",
    "Docker": {
      "ContainerName": "sqlclone-local",
      "Image": "mcr.microsoft.com/mssql/server:2022-latest",
      "HostPort": 14333,
      "SaPassword": "YourStrong!Passw0rd",
      "RemoveVolumeOnTeardown": false
    },
    "Source": {
      "ConnectionString": "Server=tcp:your-source-server.database.windows.net,1433;Initial Catalog=master;User ID=source_user;Password=source_password;Encrypt=True;TrustServerCertificate=False;",
      "EnableAlwaysEncrypted": false
    },
    "Restore": {
      "Materializer": "CreateEmpty",
      "Databases": [
        "AppDb"
      ],
      "AzureBackup": {
        "BackupUrlTemplate": "https://yourstorage.blob.core.windows.net/sql-backups/{sourceServer}/{database}.bak",
        "SharedAccessSignature": "",
        "SqlCredentialName": "SqlCloneAzureBackupSas"
      }
    },
    "//LinkedServers": "Arrays in layered .NET config merge by index — entries here cannot be removed by an environment override, only replaced. Keep committed defaults empty and define linked servers per environment. Example entry: { Name, Product: 'SQL Server', Provider: 'MSOLEDBSQL', DataSource, Catalog, UserId, Password, Rpc, RpcOut, DataAccess }.",
    "LinkedServers": {
      "Definitions": []
    },
    "ProgrammableObjects": {
      "Enabled": true,
      "ExcludeSchemas": [ "HangFire" ]
    },
    "PostClone": {
      "ScriptFolders": [
        "scripts/postclone"
      ]
    },
    "Migration": {
      "Enabled": false,
      "GitRepository": "https://github.com/your-org/your-db-migrations.git",
      "LocalRepositoryPath": "",
      "Branch": "main",
      "BuildCommand": "dotnet run --project tools/DbMigrate -- --connection \"Server=localhost,14333;Database=AppDb;User Id=sa;Password=YourStrong!Passw0rd;Encrypt=False;TrustServerCertificate=True\"",
      "WorkingDirectory": ""
    },
    "Seed": {
      "Enabled": false,
      "Strategy": "BulkCopy",
      "LinkedServerName": "",
      "SourceDatabase": "AppDb",
      "ExcludeSchemas": [],
      "InheritedParentFilterPriorityTables": [],
      "Tables": [
        {
          "SourceDatabase": "AppDb",
          "TargetDatabase": "AppDb",
          "Schema": "dbo",
          "Table": "ReferenceData",
          "TruncateTarget": true,
          "LatestRows": 10000,
          "Order": 10,
          "GroupKey": 1,
          "Children": [
            {
              "Table": "ReferenceDataTranslations"
            }
          ]
        }
      ]
    }
  }
}
