{
  "//": "Demo environment: clones the local 'demo-source' container (stood up by demo/setup-demo-source.ps1) into a fresh 'sqlclone-demo' container. Everything is local Docker — no cloud access needed. See demo/README.md.",
  "Clone": {
    "EnvironmentName": "Demo",
    "Docker": {
      "ContainerName": "sqlclone-demo",
      "Image": "mcr.microsoft.com/mssql/server:2022-latest",
      "HostPort": 14433,
      "SaPassword": "SqlClone!Demo1",
      "RemoveVolumeOnTeardown": false
    },
    "Source": {
      "ConnectionString": "Server=localhost,14999;Database=ScoutHub;User Id=sa;Password=ScoutHub!Demo1;Encrypt=False;TrustServerCertificate=True",
      "EnableAlwaysEncrypted": false
    },
    "Restore": {
      "Materializer": "CreateEmpty",
      "Databases": [
        "ScoutHub"
      ]
    },
    "LinkedServers": {
      "Definitions": []
    },
    "Migration": {
      "Enabled": true,
      "GitRepository": "",
      "LocalRepositoryPath": ".",
      "Branch": "",
      "BuildCommand": "dotnet run --project demo/ScoutHub -- \"Server=localhost,14433;Database=ScoutHub;User Id=sa;Password=SqlClone!Demo1;Encrypt=False;TrustServerCertificate=True\"",
      "WorkingDirectory": ""
    },
    "Seed": {
      "//": "Generated by `generate-seed-config --source-database ScoutHub`, then tuned: __EFMigrationsHistory removed (the migration step owns it) and ScoutingReports capped at the latest 10,000 of 50,000 rows to demo Top-N subsetting.",
      "Enabled": true,
      "Strategy": "BulkCopy",
      "SourceDatabase": "ScoutHub",
      "ExcludeSchemas": [],
      "InheritedParentFilterPriorityTables": [],
      "Tables": [
      ]
    },
    "ProgrammableObjects": {
      "Enabled": true,
      "ExcludeSchemas": []
    },
    "PostClone": {
      "ScriptFolders": [
        "scripts/postclone"
      ]
    }
  }
}
